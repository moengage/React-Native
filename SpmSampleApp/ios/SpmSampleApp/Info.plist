<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Hello App Display Name</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Geofence monitoring (react-native-moengage-geofence) asks for location
	     permission on iOS. An empty purpose string makes iOS drop the prompt, so
	     both keys carry real copy. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Used to monitor MoEngage geofences for location-triggered campaigns.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to monitor MoEngage geofences for location-triggered campaigns.</string>
	<!-- Opts the app into the UIScene life cycle. Without this key UIKit keeps
	     the legacy UIApplicationDelegate window life cycle and never calls
	     application(_:configurationForConnecting:options:), so SceneDelegate
	     would never run and the app would launch to a blank window. The scene
	     configuration itself is supplied in code by AppDelegate. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- MoEngage SDK Initialization Info -->
	<key>MoEngage</key>
	<dict>
		<key>IsSdkAutoInitialisationDisabled</key>
		<false/>
		<!-- true/false, default: false -->

		<key>WorkspaceId</key>
		<string>YOUR_APP_ID</string>
		<!-- Workspace Id, mandatory -->

		<key>DataCenter</key>
		<integer>1</integer>
		<!-- 1/2/3/4/5/6, default: 1 -->

		<key>IsTestEnvironment</key>
		<!-- <false/> -->
		<!-- true/false, customer seletected option -->
		<!-- or -->
		<string>$(SWIFT_ACTIVE_COMPILATION_CONDITIONS)|$(GCC_PREPROCESSOR_DEFINITIONS)</string>
		<!-- by default added if customer hasn't provided preference -->

		<!-- <key>IntegrationPartner</key>
		<string>segment</string> -->
		<!-- segment/mparticle, default: none -->

		<key>AppGroupName</key>
		<string>group.com.alphadevs.MoEngage.NotificationServices</string>
		<!-- App group name used for sharing SDK data, default: "" -->

		<key>AnalyticsDisablePeriodicFlush</key>
		<false/>
		<!-- true/false, default: false -->

		<key>AnalyticsPeriodicFlushDuration</key>
		<integer>60</integer>
		<!-- integer in seconds, default: 60 -->

		<key>InAppDisplaySafeAreaInset</key>
		<real>0</real>
		<!-- decimal value representing safe area padding, default: 0 -->

		<key>InAppShouldProvideDeeplinkCallback</key>
		<false />
		<!-- true/false, default: false -->

		<key>IsStorageEncryptionEnabled</key>
		<false />
		<!-- true/false, default: false -->

		<key>IsNetworkEncryptionEnabled</key>
		<false />
		<!-- true/false, default: false -->

		<key>EncryptionEncodedTestKey</key>
		<string>test</string>
		<!-- dashboard auto populated string if IsNetworkEncryptionEnabled is true -->

		<key>EncryptionEncodedLiveKey</key>
		<string>live</string>
		<!-- dashboard auto populated string if IsNetworkEncryptionEnabled is true -->

		<key>IsJwtEnabled</key>
		<false/>
		<!-- true/false, default: false -->

		<key>IsUserRegistrationEnabled</key>
		<false/>
		<!--
		true/false,
		dashboard auto populated based on enrolment enabled or not,
		default: false
		-->

		<key>LogLevel</key>
		<integer>5</integer>
		<!-- 0/1/2/3/4/5, default: 3 -->

		<key>Environment</key>
		<string>live</string>
		<!-- 
		test/live, Citi specific,
		default: based on initializeDefaultLiveInstance/initializeDefaultTestInstance
		used
		-->
	</dict>
</dict>
</plist>
