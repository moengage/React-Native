{
  "name": "SpmSampleApp",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal sample app that integrates the MoEngage React Native SDK on iOS through React Native's experimental Swift Package Manager support (react-native >= 0.87). The MoEngage packages are consumed straight from ../sdk via file: links, so this app always builds the working-tree SDK code.",
  "scripts": {
    "ios": "npm run spm && react-native run-ios",
    "start": "react-native start",
    "spm": "cd ios && npx react-native spm"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-moengage": "file:../sdk/core",
    "react-native-moengage-cards": "file:../sdk/cards",
    "react-native-moengage-geofence": "file:../sdk/geofence",
    "react-native-moengage-inbox": "file:../sdk/inbox",
    "react-native-moengage-personalize": "file:../sdk/personalize"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
